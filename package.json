{
  "name": "dsh-wps365-plugin",
  "version": "0.1.1",
  "description": "Bundle that ships the wps365-docs skill (read and write WPS 365 cloud documents) for the DeepSeek Harness",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YiuTerran/dsh-wps365-plugin.git"
  },
  "homepage": "https://github.com/YiuTerran/dsh-wps365-plugin#readme",
  "bugs": {
    "url": "https://github.com/YiuTerran/dsh-wps365-plugin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "plugin",
    "skill",
    "wps365",
    "wps",
    "kdocs",
    "otl",
    "docx",
    "xlsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "check:pack": "node scripts/check-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
